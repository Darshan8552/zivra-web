# Copy to .env — NEVER commit .env
# BACKEND_URL (server-only, TanStack createServerFn) + VITE_BACKEND_URL (browser, socket.io)
# Both must include /api prefix; version /v1 is optional due to defaultVersion fallback
# Local:
BACKEND_URL=http://localhost:3001/api/v1
VITE_BACKEND_URL=http://localhost:3001/api/v1

# Vercel env (set both):
# BACKEND_URL=https://zivra-api.onrender.com/api/v1
# VITE_BACKEND_URL=https://zivra-api.onrender.com/api/v1
# Vercel Dashboard → Settings → Environment Variables (Production + Preview)

# Optional: override API version if you set API_VERSION in zivra-api
# API_VERSION is server-side only (zivra-api/.env), client just follows BACKEND_URL
