# Copy to .env — NEVER commit .env
# BACKEND_URL must include /api prefix; version /v1 is optional due to defaultVersion fallback
# Local: http://localhost:3001/api/v1
# Prod (Vercel → Render): https://zivra-api.onrender.com/api/v1
BACKEND_URL=http://localhost:3001/api/v1

# Vercel env: set BACKEND_URL=https://zivra-api.onrender.com/api/v1 in Vercel Dashboard → Settings → Environment Variables

# Optional: override API version if you set API_VERSION in zivra-api
# API_VERSION is server-side only (zivra-api/.env), client just follows BACKEND_URL
